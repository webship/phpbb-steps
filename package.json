{
  "name": "@webship-js/phpbb-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for phpBB boards, a plugin for webship-js (Playwright and Cucumber): the board index, forums and topics, posting (a new topic, a reply, a quote, the preview, an edit, attachments, drafts, the quick reply), polls, bookmarks and subscriptions, private messages, search, the user control panel (profile, preferences, signature), the moderator control panel (the approval queue, reports, lock, move, split, delete), the administration control panel (read only), login, logout, the password reset and the refusals of the registration form.",
  "main": "tests/step-definitions/phpbb-session.steps.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "tests/fixtures/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "phpbb",
    "forum",
    "bulletin-board",
    "php",
    "moderation",
    "private-messages",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/phpbb-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/phpbb-steps/issues"
  },
  "homepage": "https://github.com/webship/phpbb-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
